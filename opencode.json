{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/kimi-k2.6",
  "instructions": [
    "~/.config/opencode/instructions/logging-standards.md",
    "~/.config/opencode/instructions/python-testing-standards.md",
    "~/.config/opencode/instructions/cover-letter.md"
  ],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true,
      "environment": {
        "BROWSER": "${BROWSER:-chromium}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GH_PERSONAL_TOKEN}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true
    },
    "mcp-obsidian": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/Users/christos/dev/mcp-obsidian",
        "run",
        "mcp-obsidian"
      ],
      "enabled": true,
      "environment": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "chmod -R *": "ask",
      "chown *": "ask",
      "dd *": "deny",
      "mkfs*": "deny",
      "gh pr merge *": "ask"
    },
    "edit": {
      "*": "allow",
      ".env*": "deny",
      "*.env": "deny",
      ".git/**": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
